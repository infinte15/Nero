# ===========================================================================
# Vorlage fuer .env. Kopieren mit:
#   cp .env.example .env && chmod 600 .env
#
# Grundregel aus dem Plan: ALLE Schluessel liegen ausschliesslich hier im Brain.
# Kein Client - kein Satellit, kein Spiegel, kein Geraete-Agent - kennt einen Key.
# ===========================================================================

# ---- Everything App -------------------------------------------------------
# Lokal:  http://localhost:8080
# Server: http://backend:8080  (internes Docker-Netz, am Tunnel und an
#         Cloudflare Access vorbei - siehe compose.yaml)
APP_API_URL=http://localhost:8080

# Langlebiges Token mit client="nero"-Claim. Wird EINMALIG im Backend erzeugt:
#   ./mvnw spring-boot:run -Dspring-boot.run.arguments="--app.nero.mint-token=true --app.nero.mint-for-username=<name>"
# und danach das Flag wieder aus. Widerruf = JWT_SECRET im Backend rotieren.
NERO_APP_TOKEN=

# ---- LLM (Stufe 2 des Routers) --------------------------------------------
# "groq" oder "null". "null" schaltet Stufe 2 ab; dann greift nur der
# Keyword-Router - genau das Verhalten, das auch offline gilt.
NERO_LLM_PROVIDER=groq

# llama-3.1-8b-instant wurde am 16.08.2026 abgeschaltet. Nachfolger laut Groq
# ist gpt-oss-20b; gpt-oss-120b ist die Eskalation, wenn 20b zu oft danebenliegt.
NERO_LLM_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# ---- Geraete (Phase 4) ----------------------------------------------------
# Ein Token je Geraet, Format "name:token,name2:token2". Leer = jeder, der das
# Brain erreicht, darf es steuern - das war bis Phase 3 in Ordnung, weil kein
# Port offen war. Seit der Satellit spricht, gehoeren hier Tokens hinein.
#
# Erzeugen:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Sperren:   den Eintrag loeschen und das Brain neu starten. Die uebrigen
#            Geraete behalten ihr Token - genau dafuer ist es eines pro Geraet.
NERO_CLIENT_TOKENS=

# ---- Spracheingabe (Whisper) ----------------------------------------------
# "groq" oder "null". Ohne GROQ_API_KEY faellt es ohnehin auf "null" zurueck;
# /listen antwortet dann mit einer Meldung, /command bleibt offen.
#
# Achtung: bei erreichtem Tagesbudget ist die Spracheingabe komplett aus - ohne
# Transkription gibt es keinen Text, auf den der Keyword-Router greifen koennte.
NERO_STT_PROVIDER=groq

# whisper-large-v3-turbo kostet 0,04 USD pro Audiostunde, whisper-large-v3
# 0,111 USD und erkennt etwas besser. Bei ~1,5 Minuten Audio am Tag ist der
# Unterschied theoretisch.
NERO_STT_MODEL=whisper-large-v3-turbo

# ---- Sprachausgabe (Piper) ------------------------------------------------
# "wyoming" oder "null". Piper laeuft als eigener Container und spricht rohes
# TCP auf 10200, kein HTTP - deshalb Host und Port statt einer URL.
#
# Lokal ohne Docker gibt es keinen Piper: dort NERO_TTS_PROVIDER=null setzen,
# dann antwortet /speak sauber mit 503 und /command laeuft unveraendert weiter.
NERO_TTS_PROVIDER=wyoming
PIPER_HOST=localhost
PIPER_PORT=10200

# Leer lassen = die Stimme, mit der der Container gestartet wurde
# (compose.yaml: --voice de_DE-thorsten-high). Nur setzen, wenn ein Container
# mehrere Stimmen vorhaelt.
NERO_TTS_VOICE=

# ---- Offline-Fallback (Phase 6) -------------------------------------------
# "ollama" oder "null". Greift in zwei Faellen: Groq antwortet nicht (Internet
# weg, Stoerung) ODER das Tagesbudget ist erreicht. Ein lokales Modell kostet
# nichts, also wird dann nicht mehr abgelehnt - die Antwort dauert nur laenger.
#
# Modell einmalig laden:
#   docker compose exec ollama ollama pull qwen2.5:1.5b
NERO_LLM_FALLBACK=ollama
OLLAMA_MODEL=qwen2.5:1.5b

# ---- Kostenbremse ---------------------------------------------------------
# Zweite Verteidigungslinie neben dem Hard-Limit beim Anbieter. Ist sie
# erreicht, antwortet Nero statt zu routen - der Keyword-Router laeuft weiter.
DAILY_LIMIT_EUR=0.50
