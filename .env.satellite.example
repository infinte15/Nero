# ===========================================================================
# Vorlage fuer .env.satellite - gehoert auf den Rechner, an dem gesprochen
# wird, nicht auf den Server.
#
#   cp .env.satellite.example .env.satellite && chmod 600 .env.satellite
#
# Was hier NICHT hineingehoert: GROQ_API_KEY, NERO_APP_TOKEN, irgendein
# Schluessel. Grundregel 1 aus dem Plan - alle Schluessel liegen im Brain, kein
# Client kennt einen. Der Satellit kennt nur seine eigene Tuerklinke.
# ===========================================================================

# ---- Brain ----------------------------------------------------------------
# Im LAN:  http://server:8090
# Von aussen: https://nero.deine-domain.de  (Cloudflare-Tunnel)
NERO_BRAIN_URL=http://localhost:8090

# Das Token dieses einen Geraets - der Teil hinter dem Doppelpunkt aus
# NERO_CLIENT_TOKENS im Brain.
NERO_DEVICE_TOKEN=

# ---- Wake Word ------------------------------------------------------------
# Mitgeliefert: hey_mycroft, alexa, hey_jarvis, hey_marvin, timer, weather.
# Hier darf auch ein Pfad auf ein selbst trainiertes .onnx stehen.
NERO_WAKE_MODEL=hey_mycroft

# Hoeher = weniger Fehlausloeser, aber man muss deutlicher sprechen.
NERO_WAKE_THRESHOLD=0.5

# Silero-VAD vor dem Wake Word: nur was nach Stimme klingt, zaehlt als Treffer.
# Der wirksamste Regler gegen Musik und Fernseher. 0 schaltet ihn ab.
NERO_WAKE_VAD_THRESHOLD=0.5

# ---- Aufnahme -------------------------------------------------------------
# Ab welchem Vielfachen des gemessenen Grundrauschens etwas als Sprache gilt.
# Der wichtigste Regler ueberhaupt. Einstellen mit:
#   python -m nero.satellite --pegel
# Erst still sein, dann normal sprechen - der Faktor gehoert dazwischen.
NERO_SILENCE_FACTOR=2.5

# Wie lange Stille den Befehl beendet.
NERO_SILENCE_SECONDS=0.8

# ---- Audiogeraete ---------------------------------------------------------
# Leer = Systemvorgabe. Namen oder Index aus:
#   python -m nero.satellite --geraete
NERO_INPUT_DEVICE=
NERO_OUTPUT_DEVICE=
