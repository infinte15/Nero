# ===========================================================================
# Vorlage fuer .env.agent - gehoert auf den Rechner, der gesteuert werden soll
# (Linux-PC, Windows-PC, Laptop).
#
#   cp .env.agent.example .env.agent && chmod 600 .env.agent
#
# Wie beim Satelliten: kein API-Schluessel, kein App-Token. Der Agent kennt nur
# das Brain und seine eigene Programmliste.
# ===========================================================================

NERO_BRAIN_URL=http://server:8090

# Das Token dieses Geraets aus NERO_CLIENT_TOKENS im Brain. Der Name davor
# entscheidet, wie Nero das Geraet nennt - "sperr den Laptop" trifft das Geraet,
# dessen Token als "laptop:..." eingetragen ist.
NERO_DEVICE_TOKEN=

# ---- Programme ------------------------------------------------------------
# Positivliste: "gesprochener name=befehl", kommasepariert. NUR was hier steht,
# laesst sich starten.
#
# Das ist kein Formalismus. Der Entwurf im Plan macht subprocess.Popen mit dem
# Namen, den das Sprachmodell geliefert hat - der Weg vom Mikrofon bis hierher
# fuehrt durch eine Spracherkennung und ein Modell, beide koennen irren, und wer
# in Hoerweite steht, kann es absichtlich. Hier steht deshalb eine Liste.
NERO_APPS=firefox=firefox,musik=spotify,code=code,dateien=nautilus

# ---- Was der Rechner dafuer braucht ---------------------------------------
# Linux:   xdotool (X11) oder wtype (Wayland) zum Tippen,
#          pactl (pulseaudio-utils) fuer die Lautstaerke,
#          loginctl oder xdg-screensaver zum Sperren
# Windows: pip install -e '.[agent]' bringt pycaw fuer die Lautstaerke mit;
#          Sperren und Tippen kann Windows selbst
